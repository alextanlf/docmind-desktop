{
  "name": "docmind-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "verify": "./scripts/test.sh",
    "build": "./scripts/build.sh",
    "desktop:dev": "electron-vite dev",
    "desktop:build": "electron-vite build",
    "desktop:test": "ELECTRON_OVERRIDE_DIST_PATH=/dev/null ELECTRON_SKIP_BINARY_DOWNLOAD=1 vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint electron e2e --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "npm run desktop:test",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "44.1.0",
    "electron-vite": "5.0.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
